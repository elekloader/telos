{
 "id": "telos",
 "version": "0.3",
 "title": "TELOS",
 "category": "Framework",
 "license": "GPL-2.0-or-later",
 "author": "irpina",
 "description": "Mods kept on the Digitone II itself (OS 1.12, core-dn2 0.5 or newer): a store in raw sectors of the card (from 0x7FE000) holds .elemod files, and at every boot TELOS links the ones switched on into the core's area, with no new firmware. SETTINGS > MODS (TELOS) lists them: YES switches one on or off, APPLY & RESTART links the new set. A crash guard skips the mods once after a boot that didn't get 10 s in. Each project slot keeps the mods it was saved with: loading one whose mods differ asks LOAD PROJECT MODS?. tools/telos.py puts mods in the store over USB MIDI SysEx (python tools/telos.py unit --device digitone-mk2 ...).",
 "device": "digitone-mk2",
 "os": "1.12",
 "sources": [
  "../telos.c",
  "../page.c",
  "../upload.c",
  "../row.s",
  "../flush.s",
  "store.c",
  "../vendor/drive-loader/dlink.c",
  "../vendor/drive-loader/json.c",
  "../projset.c"
 ],
 "cflags": [
  "-Os",
  "-fno-ipa-sra",
  "-DDL_SITES",
  "-DDL_REGIONS",
  "-DTELOS_DT1",
  "-DTELOS_DN2"
 ],
 "defsym": {
  "STR_CTOR": "0x401ceab8",
  "IMAGE_END": "0x4030c980"
 },
 "subscribe": [
  {
   "event": "ev_card_ready",
   "fn": "telos_card_ready",
   "order": 1
  },
  {
   "event": "ev_sysex",
   "fn": "telos_sysex",
   "order": 1
  },
  {
   "event": "ev_settings",
   "fn": "telos_settings",
   "order": 90
  },
  {
   "event": "ev_key",
   "fn": "telos_key",
   "order": 1
  },
  {
   "event": "ev_enc",
   "fn": "telos_enc",
   "order": 1
  },
  {
   "event": "ev_tick",
   "fn": "telos_tick",
   "order": 90
  },
  {
   "event": "ev_draw",
   "fn": "telos_draw",
   "order": 99
  },
  {
   "event": "ev_crash",
   "fn": "telos_crash",
   "order": 1
  },
  {
